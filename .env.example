# Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Portfolio <contact@your-domain.com>
RESEND_TO_EMAIL=you@your-domain.com

# Cloudflare Turnstile
# NEXT_PUBLIC_ is required because the site key is safe and must reach the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
# Keep the secret key server-only; never prefix it with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
